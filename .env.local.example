# ============================================
# 浅草心情 环境变量配置模板
# ============================================
# 使用方式：cp .env.local.example .env.local
# 然后填入真实的配置值
# 
# 注意：.env.local 已在 .gitignore 中忽略，
# 不会被提交到 Git，确保密钥安全。
# ============================================

# --- 腾讯混元 AI（必填）---
# 获取地址：https://console.cloud.tencent.com/cam/capi
HUNYUAN_SECRET_ID=your_secret_id_here
HUNYUAN_SECRET_KEY=your_secret_key_here

# --- AI 提供商（可选）---
# 支持: hunyuan | openai | custom
# 默认 hunyuan
AI_PROVIDER=hunyuan

# --- OpenAI（仅 AI_PROVIDER=openai 时需要）---
# OPENAI_API_KEY=sk-your_openai_api_key_here

# --- 自定义 AI（仅 AI_PROVIDER=custom 时需要）---
# AI_API_KEY=your_custom_api_key_here

# --- 微信小程序 ---
# 微信公众平台获取：https://mp.weixin.qq.com
TARO_APP_WEAPP_APPID=your_weapp_appid_here
# 微信云开发环境 ID
TARO_APP_CLOUD_ENV_ID=your_cloud_env_id_here

# --- 抖音小程序 ---
# 抖音开放平台获取：https://developer.open-douyin.com
TARO_APP_TT_APPID=your_tt_appid_here
TARO_APP_TT_EMAIL=your_tt_email_here
TARO_APP_TT_PASSWORD=your_tt_password_here

# --- 部署域名 ---
# 生产环境部署的域名（H5 端需要）
PROJECT_DOMAIN=
# Coze 平台默认域名（可选，作为 PROJECT_DOMAIN 的 fallback）
COZE_PROJECT_DOMAIN_DEFAULT=